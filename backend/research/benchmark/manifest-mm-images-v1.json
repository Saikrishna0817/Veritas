{
  "schema_version": 2,
  "benchmark_id": "veritas-image-poisoning-v1",
  "created_at": "2026-11-08",
  "immutable": true,
  "random_seed": 20261108,
  "source": "torchvision datasets (MD5-verified archives), ResNet-18 ImageNet embeddings; attacks applied to raw pixels",
  "reference_fraction": 0.6,
  "calibration_fraction_of_reference": 0.3,
  "batch_rows": 3000,
  "pca_dims": 32,
  "datasets": {
    "dev": [{"data_id": "fashion_mnist"}, {"data_id": "cifar100"}],
    "test": [{"data_id": "cifar10"}, {"data_id": "gtsrb"}]
  },
  "attacks": ["label_flip_random", "label_flip_targeted", "patch_backdoor", "blended_backdoor",
              "clean_label_backdoor", "duplicate_flood", "class_noise"],
  "poison_rates": [0.01, 0.03, 0.05, 0.1],
  "seeds": 5,
  "clean_batches_per_seed": 4,
  "detectors": ["cleanlab_hgb", "knn_label", "isolation_forest", "ecod", "c2st", "veritas2"],
  "metrics": {"row": ["auroc", "auprc", "precision_at_k"], "batch": {"tpr_at_clean_fpr": 0.05, "tail_quantile": 0.99},
              "ci": {"method": "cluster bootstrap over datasets", "resamples": 1000, "level": 0.95}},
  "profiles": {"smoke": {"datasets": ["fashion_mnist", "cifar10"], "seeds": 1, "poison_rates": [0.05],
                         "clean_batches_per_seed": 2}},
  "policy": "Tune only on dev datasets; the test datasets are the headline. Never edit this file in place: create a new benchmark_id for any change. Real human-noise results (CIFAR-10N) live in bench_realnoise and are reported separately from injected-attack results."
}

{
 "schema_version": 2,
 "benchmark_id": "veritas-image-poisoning-ext-v1",
 "created_at": "2026-11-15",
 "immutable": true,
 "random_seed": 20261108,
 "source": "torchvision datasets (MD5-verified archives), ResNet-18 ImageNet embeddings; attacks applied to raw pixels",
 "reference_fraction": 0.6,
 "calibration_fraction_of_reference": 0.3,
 "batch_rows": 3000,
 "pca_dims": 32,
 "datasets": {
  "test": [
   {
    "data_id": "cifar10"
   },
   {
    "data_id": "gtsrb"
   }
  ]
 },
 "attacks": [
  "bb_badnets",
  "bb_blended",
  "bb_sig",
  "bb_lowfreq",
  "bb_ftrojan"
 ],
 "poison_rates": [
  0.01,
  0.03,
  0.05,
  0.1
 ],
 "seeds": 5,
 "clean_batches_per_seed": 24,
 "detectors": [
  "veritas_mm",
  "mm_label",
  "mm_shift",
  "mm_pixel",
  "mm_dup",
  "mm_cell",
  "mm_resid",
  "mm_chroma",
  "mm_sig"
 ],
 "metrics": {
  "row": [
   "auroc",
   "auprc",
   "precision_at_k"
  ],
  "batch": {
   "tpr_at_clean_fpr": 0.05,
   "tail_quantile": 0.99
  },
  "ci": {
   "method": "cluster bootstrap over datasets",
   "resamples": 1000,
   "level": 0.95
  }
 },
 "profiles": {
  "smoke": {
   "datasets": [
    "fashion_mnist",
    "cifar10"
   ],
   "seeds": 1,
   "poison_rates": [
    0.05
   ],
   "clean_batches_per_seed": 2
  }
 },
 "policy": "External attacks (BackdoorBench), not written by the detector's author. Detector frozen at git commit 722925d; no tuning on these results; run and quoted once. Original rules: never edit this file in place.",
 "change": "adds the within-class signature check 'sig' (clean-label triggers; penalty 1.3, row gate 2.3), chosen on dev: research/mm/classsig_study_dev.py and research/mm/combine_study_dev.py",
 "source_attacks": {
  "repo": "https://github.com/SCLBD/BackdoorBench",
  "commit": "f02e3534645f0ee63d6848653062cd6c0d6c400d",
  "license": "CC BY-NC 4.0 (code loaded at runtime from a local checkout, not copied)",
  "note": "Parameters are their CIFAR-10 defaults. Poison rate is ours (poison_rates), not their pratio. Images are 32x32 like theirs.",
  "attacks": {
   "bb_badnets": {
    "class": "utils/bd_img_transform/patch.py AddMaskPatchTrigger",
    "params": {
     "patch_mask_path": "resource/badnet/trigger_image.png (32x32)",
     "label": "all2one, non-target images to target"
    },
    "config": "config/attack/badnet/default.yaml"
   },
   "bb_blended": {
    "class": "utils/bd_img_transform/blended.py blendedImageAttack",
    "params": {
     "trigger_img": "resource/blended/hello_kitty.jpeg resized to 32x32 (bilinear)",
     "attack_train_blended_alpha": 0.2,
     "label": "all2one"
    },
    "config": "config/attack/blended/default.yaml"
   },
   "bb_sig": {
    "class": "utils/bd_img_transform/sig.py sigTriggerAttack",
    "params": {
     "sig_delta": 40,
     "sig_f": 6,
     "label": "clean-label: target-class images, labels unchanged"
    },
    "config": "config/attack/sig/default.yaml"
   },
   "bb_lowfreq": {
    "class": "utils/bd_img_transform/patch.py SimpleAdditiveTrigger",
    "params": {
     "pattern": "resource/lowFrequency/cifar10_preactresnet18_0_255.npy (CIFAR-10 universal perturbation, applied unchanged to gtsrb as well)",
     "label": "all2one"
    },
    "config": "config/attack/lf/default.yaml; pattern path from attack/lf.py"
   },
   "bb_ftrojan": {
    "class": "utils/bd_img_transform/ftrojann.py ftrojann_version",
    "params": {
     "YUV": true,
     "channel_list": [
      1,
      2
     ],
     "window_size": 32,
     "magnitude": 30,
     "pos_list": [
      [
       15,
       15
      ],
      [
       31,
       31
      ]
     ],
     "label": "all2one"
    },
    "config": "config/attack/ftrojannn/default.yaml"
   }
  }
 }
}

# Veritas settings for docker-compose.yml. Copy to .env and fill in; never commit .env.
# Every value here is a placeholder. Lines marked "required" make `docker compose up` stop with an error if empty.

# ── Required ───────────────────────────────────────────────────────────────────────────────────────────────────────
# required: database password (any long random string)
POSTGRES_PASSWORD=change-me-postgres-password
# required: signs sessions; at least 32 random characters
VERITAS_JWT_SECRET=change-me-to-32-or-more-random-chars
# required: admin account created at startup
VERITAS_ADMIN_USERNAME=admin
# required: not a known default, at least 8 characters
VERITAS_ADMIN_PASSWORD=change-me-admin-password

# ── Sessions and two-factor ────────────────────────────────────────────────────────────────────────────────────────
# minutes an access session lasts before the browser renews it with its refresh token
VERITAS_JWT_EXPIRY_MINUTES=60
# days a browser stays signed in without activity (refresh token lifetime)
VERITAS_REFRESH_EXPIRY_DAYS=14
# true: admin-only endpoints answer 403 until the admin has turned on two-factor sign-in (Account page)
VERITAS_REQUIRE_ADMIN_2FA=false

# ── Public address ─────────────────────────────────────────────────────────────────────────────────────────────────
# host port nginx is published on
WEB_PORT=5173
# base URL put in emailed links (https://your.domain in production)
VERITAS_PUBLIC_URL=http://localhost:5173
# origins allowed to call the API (your site's https origin)
CORS_ALLOW_ORIGINS=http://localhost:5173
# true behind HTTPS; false only for plain-HTTP local use
VERITAS_COOKIE_SECURE=false

# ── Email (sign-up confirmation, password reset). Empty host: mails are only written to the API log ───────────────
# e.g. smtp.resend.com, or localhost for a local catcher
VERITAS_SMTP_HOST=
# 587 with STARTTLS for providers; a local catcher may use 1025
VERITAS_SMTP_PORT=587
# SMTP login, if the provider needs one
VERITAS_SMTP_USER=
# SMTP password or API key (secret)
VERITAS_SMTP_PASSWORD=
# sender shown on outgoing mail
VERITAS_MAIL_FROM=Veritas <no-reply@localhost>

# ── Cloudflare Turnstile (human check on sign-up and password reset). Set both or neither ─────────────────────────
# secret key (server side); empty turns the check off
VERITAS_TURNSTILE_SECRET=
# site key (public, built into the web app); empty hides the widget
VITE_TURNSTILE_SITE_KEY=

# ── File storage. Default: the shared uploads volume ───────────────────────────────────────────────────────────────
# or s3://bucket for S3 / Cloudflare R2 (enables direct uploads)
VERITAS_STORAGE_URL=file:///uploads
# R2: https://<account>.r2.cloudflarestorage.com; empty for AWS
VERITAS_S3_ENDPOINT=
# bucket access key (S3/R2 only)
AWS_ACCESS_KEY_ID=
# bucket secret key (S3/R2 only, secret)
AWS_SECRET_ACCESS_KEY=

# ── Media worker limits (images, audio, video, model files) ──────────────────────────────────────────────────────
# memory cap for worker-media
MEDIA_WORKER_MEMORY=6g
# CPU cap for worker-media
MEDIA_WORKER_CPUS=2

# ── Monitoring (optional) ─────────────────────────────────────────────────────────────────────────────────────────
# bearer token for /metrics; empty hides it
VERITAS_METRICS_TOKEN=
# error reporting; empty turns it off
SENTRY_DSN=

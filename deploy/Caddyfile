# Production edge (docker-compose.prod.yml): HTTPS with automatic certificates, HSTS, and the real client address.
# Cloudflare proxies the domain (SSL mode "Full (strict)"); Caddy trusts the forwarded client address only from
# Cloudflare's ranges, so a request that skips Cloudflare cannot choose its own address.
# ponytail: static copy of https://www.cloudflare.com/ips-v4 and /ips-v6 (2026-11-25); refresh if Cloudflare adds ranges.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
	email {$ACME_EMAIL}
}

{$VERITAS_DOMAIN} {
	encode gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	# Caddy sets X-Forwarded-For to the client address it determined; whatever the client sent is not passed on.
	reverse_proxy frontend:5173 {
		header_up X-Forwarded-For {client_ip}
	}
}
